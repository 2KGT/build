# .github/scripts/modules/twitter_handler.py
import os
import shutil

# Khớp với mọi bundle ID Twitter/X:
#   com.atebits.Tweetie2       (Twitter + X iOS - hiện tại)
#   com.atebits.Tweetie2.ios   (Twitter Lite)
#   com.twitter.twitter        (bản rất cũ)
IDENTIFIER = "tweetie"

# Keyword log class đáng chú ý
_CLASS_KEYWORDS = [
    "Ad", "Promoted", "Timeline", "Feed", "Video", "Player",
    "Tweet", "Status", "Analytics", "Block", "Filter", "Ranking",
]

# Keyword log selector đáng chú ý
_SELECTOR_KEYWORDS = [
    "ad", "promoted", "sponsored", "quality", "video",
    "download", "watermark", "block", "hide",
    "timeline", "rank",
]


def _ensure_bridge_h(header_dir):
    """Sinh Bridge.h từ ClassList.txt nếu workflow dump chưa sinh."""
    bridge = os.path.join(header_dir, "Bridge.h")
    cls_list = os.path.join(header_dir, "ClassList.txt")
    if os.path.exists(bridge) or not os.path.exists(cls_list):
        return
    print("   [TW-HANDLER] 📝 Sinh Bridge.h từ ClassList.txt")
    with open(cls_list, "r", encoding="utf-8") as f:
        classes = [l.strip() for l in f if l.strip()]
    with open(bridge, "w", encoding="utf-8") as f:
        f.write("// Auto-generated by twitter_handler.py\n")
        f.write("@import Foundation;\n@import UIKit;\n\n")
        for c in classes:
            f.write(f"@class {c};\n")


def _log_interesting(header_dir):
    """Log các class/selector tiềm năng để dev biết đường hook."""
    cls_list = os.path.join(header_dir, "ClassList.txt")
    sel_list = os.path.join(header_dir, "Selectors.txt")

    if os.path.exists(cls_list):
        with open(cls_list, "r", encoding="utf-8") as f:
            hits = [l.strip() for l in f
                    if any(k.lower() in l.lower() for k in _CLASS_KEYWORDS)]
        print(f"   [TW-HANDLER] 🎯 {len(hits)} class tiềm năng:")
        for h in hits[:15]:
            print(f"       • {h}")
        if len(hits) > 15:
            print(f"       … (+{len(hits) - 15} class khác)")

    if os.path.exists(sel_list):
        with open(sel_list, "r", encoding="utf-8") as f:
            hits = [l.strip() for l in f
                    if any(k.lower() in l.lower() for k in _SELECTOR_KEYWORDS)]
        print(f"   [TW-HANDLER] 🎯 {len(hits)} selector tiềm năng:")
        for h in hits[:15]:
            print(f"       • {h}")
        if len(hits) > 15:
            print(f"       … (+{len(hits) - 15} selector khác)")


def _link_or_copy(src, dst, label=""):
    if os.path.exists(dst) or os.path.islink(dst):
        print(f"   [TW-HANDLER] Đã có {label or dst}")
        return
    try:
        os.symlink(src, dst)
        print(f"   [TW-HANDLER] 🔗 {label or dst}")
    except OSError:
        shutil.copytree(src, dst)
        print(f"   [TW-HANDLER] 📋 {label or dst}")


def setup(proj, config):
    """
    Được build_engine.py gọi: mod.setup(proj, {})

    proj   : tên thư mục dự án (vd "Twitter" hoặc "X")
    config : dict cấu hình bổ sung (hiện rỗng)
    """
    repo_root = os.environ.get("GITHUB_WORKSPACE", os.getcwd())
    target_dir = os.path.join(repo_root, proj)

    if not os.path.isdir(target_dir):
        print(f"   [TW-HANDLER] ⚠️  Không thấy thư mục dự án: {target_dir}")
        return

    # 1. Tìm header đã dump (đặt tên thư mục theo dự án: TwitterHeader hoặc XHeader)
    candidates = [
        os.path.join(repo_root, "headers", "TwitterHeader"),
        os.path.join(repo_root, "headers", "XHeader"),
        os.path.join(repo_root, "headers", "TweetieHeader"),
    ]
    local_dump = next((p for p in candidates if os.path.exists(p)), None)

    if not local_dump:
        print(f"   [TW-HANDLER] ⚠️  Không tìm thấy header dump. Đã thử:")
        for p in candidates:
            print(f"       - {p}")
        print(f"   [TW-HANDLER]    → Chạy workflow Dump-Class.yml cho Twitter/X trước.")
        return

    print(f"   [TW-HANDLER] Dùng header dump: {os.path.relpath(local_dump, repo_root)}")

    # 2. Sinh Bridge.h nếu cần + log class/selector
    _ensure_bridge_h(local_dump)
    _log_interesting(local_dump)

    # 3. Symlink vào project
    header_folder_name = os.path.basename(local_dump)  # "TwitterHeader" / "XHeader" / ...
    _link_or_copy(
        local_dump,
        os.path.join(target_dir, header_folder_name),
        label=header_folder_name
    )

    print(f"   [TW-HANDLER] ✅ Hoàn tất chuẩn bị header cho {proj}")
    print(f"   [TW-HANDLER]    → Tweak.x dùng: #import \"{header_folder_name}/Bridge.h\"")