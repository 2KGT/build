{
  "_doc": "Danh mục tweak dùng cho workflow Package.yml. Token trong ô 'Tweak': tên (hoặc tên@phiên_bản) | preset:tên | repo:Dự_án | link http(s) | file:đường_dẫn_trong_repo. kind: source (clone + Theos make) | release (GitHub Release) | sparse (lấy một thư mục, vd .appex) | url (tải thẳng).",
  "defaults": {
    "build_args": "DEBUG=0 FINALPACKAGE=1 THEOS_PACKAGE_SCHEME=rootless",
    "headers": {
      "YouTubeHeader": "https://github.com/PoomSmart/YouTubeHeader.git",
      "PSHeader": "https://github.com/PoomSmart/PSHeader.git"
    }
  },
  "presets": {
    "youmod": ["repo:YouMod", "openyt", "yougroupsettings", "youpip", "ytuhd", "ryd", "abconfig", "youquality", "youspeed", "demc", "youmute", "youloop", "youslider", "ytholdspeed", "youchoose", "youshare", "ytweaks", "gonerino", "getcap", "ytshare", "volboost"],
    "ytlite": ["ytplus", "openyt"],
    "ytlite-full": ["preset:ytlite", "youpip", "ytuhd", "youquality", "ryd", "abconfig", "demc"]
  },
  "tweaks": {
    "ytplus": {"kind": "release", "title": "YTLite (YouTube Plus)", "repo": "dayanch96/YTLite", "pattern": "*.deb", "tags": ["v{ver}", "{ver}"], "default_version": "5.2.1", "aliases": ["ytlite"]},
    "openyt": {"kind": "sparse", "title": "Open in YouTube (Safari extension)", "repo": "https://github.com/BillyCurtis/OpenYouTubeSafariExtension.git", "path": "OpenYouTubeSafariExtension.appex", "aliases": ["openyoutube"]},
    "ytvideooverlay": {"kind": "source", "repo": "https://github.com/PoomSmart/YTVideoOverlay.git"},
    "yougroupsettings": {"kind": "source", "repo": "https://github.com/PoomSmart/YouGroupSettings.git", "aliases": ["ygs"]},
    "youpip": {"kind": "source", "repo": "https://github.com/PoomSmart/YouPiP.git", "requires": ["ytvideooverlay"]},
    "ytuhd": {"kind": "source", "repo": "https://github.com/Tonwalter888/YTUHD.git", "requires": ["ytvideooverlay"]},
    "ryd": {"kind": "source", "repo": "https://github.com/PoomSmart/Return-YouTube-Dislikes.git", "aliases": ["return-youtube-dislikes"]},
    "abconfig": {"kind": "source", "repo": "https://github.com/PoomSmart/YTABConfig.git", "aliases": ["ytabc", "ytabconfig"]},
    "youquality": {"kind": "source", "repo": "https://github.com/PoomSmart/YouQuality.git", "requires": ["ytvideooverlay"], "aliases": ["yq"]},
    "youspeed": {"kind": "source", "repo": "https://github.com/PoomSmart/YouSpeed.git", "requires": ["ytvideooverlay"]},
    "demc": {"kind": "source", "repo": "https://github.com/therealFoxster/DontEatMyContent.git", "pre": ["rm -rf \"$THEOS/include/YTHeaders\"", "cp -r \"$THEOS/include/YouTubeHeader\" \"$THEOS/include/YTHeaders\""], "aliases": ["donteatmycontent"]},
    "youmute": {"kind": "source", "repo": "https://github.com/PoomSmart/YouMute.git", "requires": ["ytvideooverlay"]},
    "youloop": {"kind": "source", "repo": "https://github.com/bhackel/YouLoop.git", "requires": ["ytvideooverlay"]},
    "alderis": {"kind": "source", "repo": "https://github.com/hbang/Alderis.git", "build_args": "DEBUG=0 FINALPACKAGE=1 ARCHS=arm64"},
    "youslider": {"kind": "source", "repo": "https://github.com/PoomSmart/YouSlider.git", "requires": ["alderis"]},
    "ytholdspeed": {"kind": "source", "repo": "https://github.com/joshuaseltzer/YTHoldForSpeed.git", "build_args": "DEBUG=0 FINALPACKAGE=1 THEOS_PACKAGE_SCHEME=rootless TARGET=iphone:clang:latest:15.0 ARCHS=arm64", "aliases": ["ytholdforspeed"]},
    "youchoose": {"kind": "source", "repo": "https://github.com/PoomSmart/YouChooseQuality.git", "commit": "1585a3691b2ef0b59d42c40c31639fd8b79e2cd4", "aliases": ["youchoosequality"]},
    "youshare": {"kind": "source", "repo": "https://github.com/Tonwalter888/YouShare.git", "requires": ["ytvideooverlay"]},
    "ytweaks": {"kind": "source", "repo": "https://github.com/fosterbarnes/YTweaks.git"},
    "gonerino": {"kind": "source", "repo": "https://github.com/castdrian/Gonerino.git"},
    "getcap": {"kind": "source", "repo": "https://github.com/PoomSmart/YouGetCaption.git", "requires": ["ytvideooverlay"], "aliases": ["yougetcaption"]},
    "ytshare": {"kind": "source", "repo": "https://github.com/jkhsjdhjs/youtube-native-share.git", "pre": ["git clone --quiet --depth=1 https://github.com/protocolbuffers/protobuf.git"], "build_args": "DEBUG=0 FINALPACKAGE=1 THEOS_PACKAGE_SCHEME=rootless ARCHS=arm64", "aliases": ["youtube-native-share"]},
    "volboost": {"kind": "source", "repo": "https://github.com/VasirakCalgux/VolumeBoostYT.git", "build_args": "DEBUG=0 FINALPACKAGE=1 THEOS_PACKAGE_SCHEME=rootless ARCHS=arm64", "aliases": ["volumeboostyt"]}
  }
}
